{
  "info": {
    "name": "Wellbeing (Team 16) — public API for Team 14 (contract 2.0)",
    "description": "Contract: Team14-Integration-Contract.md, version 2.0. Public, no authentication. Call from your server: no CORS headers are sent.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://wellbeing-intake.vercel.app/api/v1"
    },
    {
      "key": "correlationId",
      "value": "team14-v2-0001"
    }
  ],
  "item": [
    {
      "name": "1 List services (valid request)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/services",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "services"
          ]
        },
        "description": "The whole catalogue, as a plain JSON array. Store `id` on your ticket (e.g. srv_academic_stress); it never changes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"correlation id echoed\", () => pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.eql(pm.collectionVariables.get(\"correlationId\")));",
              "const body = pm.response.json();",
              "pm.test(\"a plain non-empty array\", () => pm.expect(body).to.be.an(\"array\").that.is.not.empty);",
              "pm.test(\"only the known stable ids\", () => body.forEach(s => pm.expect([\"srv_academic_stress\",\"srv_general_counselling\",\"srv_urgent_drop_in\"]).to.include(s.id)));",
              "pm.test(\"contract fields present\", () => body.forEach(s => { pm.expect(s.name).to.be.a(\"string\"); pm.expect(s.description).to.be.a(\"string\"); pm.expect(s.duration_minutes).to.be.a(\"number\"); pm.expect(s.is_active).to.eql(true); }));"
            ]
          }
        }
      ]
    },
    {
      "name": "2 Wrong method (invalid request)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/services",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "services"
          ]
        },
        "description": "Only GET is supported."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"405\", () => pm.response.to.have.status(405));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 Staff-only endpoint without signing in (outside this contract)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/practitioner/queue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "practitioner",
            "queue"
          ]
        },
        "description": "Shown only to demonstrate an authentication failure. Student data is never shared with Helpdesk."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401\", () => pm.response.to.have.status(401));",
              "pm.test(\"stable error code\", () => pm.expect(pm.response.json().error).to.eql(\"unauthenticated\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "4 Unknown path",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/services/dentistry",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "services",
            "dentistry"
          ]
        },
        "description": "There is no by-id endpoint: fetch the list and match on `id`."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "200 ok / 503 degraded."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200\", () => pm.response.to.have.status(200));",
              "pm.test(\"database up\", () => pm.expect(pm.response.json().database).to.eql(\"up\"));"
            ]
          }
        }
      ]
    }
  ]
}
