# Copy to .env.local (never commit it). NOTHING here may carry a NEXT_PUBLIC_ prefix.

# --- Supabase (local: values printed by `pnpm db:env`; hosted: Project Settings > API) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Staff sign-in. Students are anonymous and never sign in. ---
# fixture = Supabase Auth demo accounts
IDENTITY_MODE=fixture
IDENTITY_JWKS_URL=
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=wellbeing

# Origin allowed on cookie-authenticated writes. Empty = the request's own origin.
APP_ORIGIN=

# --- Generate each secret below with:  openssl rand -hex 24   (the app refuses empty values) ---
# Lets a retried submission get the same Private Access Key back. Keep it stable once deployed.
ACCESS_KEY_SECRET=

# --- Outbound webhook to the Notification Hub ---
# Until a real Hub exists, point this at the built-in contract mock.
HUB_WEBHOOK_URL=http://localhost:3000/api/v1/mock/hub
HUB_SIGNING_SECRET=
HUB_MACHINE_TOKEN=
# Secret the Hub signs its delivery receipts with (inbound webhook receiver)
HUB_INBOUND_SECRET=
# While true, PUT /api/v1/mock/hub (the outage switch) still requires the DISPATCH_TOKEN bearer.
MOCK_HUB_ENABLED=true

# Machine credential for POST /api/v1/internal/events/dispatch (also a GitHub Actions secret)
DISPATCH_TOKEN=
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_BACKOFF_BASE_SECONDS=30

# --- AI urgency assessment, with a deterministic fallback ---
# With AI_TRIAGE_ENABLED=false (or no key) the urgency phrases and the student's own choice decide.
AI_TRIAGE_ENABLED=false
# Provider: Groq (free tier, no card). Key from https://console.groq.com -> API Keys.
# Leave LLM_MODEL / LLM_BASE_URL empty for the defaults: openai/gpt-oss-20b at https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
AI_DAILY_BUDGET=200
AI_TIMEOUT_MS=3000

# --- Partner: Team 14 Helpdesk (we read their public campus contacts list) ---
# e.g. https://helpdesk-api.team-helpdesk.workers.dev/api/v1. Empty = off: the hard-coded numbers are used.
HELPDESK_API_BASE_URL=

# --- Anonymous abuse limits (per-address counts are per 10 minutes and kept in memory only) ---
RATE_REQUESTS_PER_IP=5
RATE_KEY_FAILURES_PER_IP=20
RATE_TRIAGE_CHECKS_PER_IP=10
RATE_REQUESTS_PER_HOUR=60
BOOKING_HORIZON_DAYS=30

# No analytics, no telemetry
NEXT_TELEMETRY_DISABLED=1

# Local frontend preview only. Ignored by production builds.
UI_PREVIEW=false

# Seed script. A hosted database needs a private value: the seed refuses this default there.
SEED_PASSWORD=demo-password-16
